#!/bin/sh
# pre-push hook
# 1. Auto-stage submodule pointer if submodule has new commits
# 2. Verify .trae/skills/ <-> .claude/skills/ are in sync
# 3. Block push if .trae/ files are staged

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# --- Submodule auto-stage ---
if [ -f "${ROOT_DIR}/.gitmodules" ]; then
    SUBMODULE_STATUS=$(cd "$ROOT_DIR" && git submodule status 2>/dev/null)
    if echo "$SUBMODULE_STATUS" | grep -q '^+'; then
        echo "[submodule] Submodule has uncommitted updates, auto-staging..."
        (cd "$ROOT_DIR" && git add .gitmodules 2>/dev/null)
        # Stage each submodule with + prefix
        echo "$SUBMODULE_STATUS" | while read line; do
            if echo "$line" | grep -q '^+'; then
                sub_path=$(echo "$line" | awk '{print $2}')
                (cd "$ROOT_DIR" && git add "$sub_path" 2>/dev/null)
            fi
        done
    fi
fi

# --- Skills sync ---
SYNC_SCRIPT="${ROOT_DIR}/scripts/sync-agent-dirs.sh"

STAGED_CLAUDE=$(git diff --cached --name-only -- ".claude/skills/" 2>/dev/null)
STAGED_TRAE=$(git diff --cached --name-only -- ".trae/" 2>/dev/null)

if [ -z "$STAGED_CLAUDE" ] && [ -z "$STAGED_TRAE" ]; then
    exit 0
fi

if [ -f "$SYNC_SCRIPT" ] && [ -d "${ROOT_DIR}/.trae/skills" ]; then
    sh "$SYNC_SCRIPT" --check
    CHECK_RESULT=$?
    if [ $CHECK_RESULT -ne 0 ]; then
        echo ""
        echo "[BLOCKED] .trae/skills/ and .claude/skills/ are NOT in sync!"
        echo "  Run: sh scripts/sync-agent-dirs.sh"
        echo "  Then: git add .claude/skills/ && git commit --amend --no-edit"
        echo ""
        exit 1
    fi
fi

if [ -n "$STAGED_TRAE" ]; then
    echo ""
    echo "[BLOCKED] .trae/ files are staged for commit!"
    echo "  .trae/ should NOT be pushed (it is a local Trae IDE working copy)."
    echo "  Remove from staging: git reset HEAD .trae/"
    echo ""
    exit 1
fi

exit 0