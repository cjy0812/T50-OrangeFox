#!/bin/sh
# pre-commit hook
# If .trae/ exists, sync .trae/skills/ -> .claude/skills/ before commit
# This captures any edits made in Trae IDE

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TRAE_DIR="${ROOT_DIR}/.trae"
SYNC_SCRIPT="${ROOT_DIR}/scripts/sync-agent-dirs.sh"

if [ ! -d "$TRAE_DIR" ]; then
    exit 0
fi

if [ ! -f "$SYNC_SCRIPT" ]; then
    echo "[WARN] sync-agent-dirs.sh not found, skip sync"
    exit 0
fi

sh "$SYNC_SCRIPT" --trae-to-claude
if [ $? -ne 0 ]; then
    echo "[ERROR] Failed to sync .trae/skills/ -> .claude/skills/"
    exit 1
fi

CHANGED=$(git diff --name-only --cached -- ".claude/skills/" 2>/dev/null)
UNCHANGED=$(git diff --name-only -- ".claude/skills/" 2>/dev/null)

if [ -n "$UNCHANGED" ]; then
    git add ".claude/skills/"
fi

exit 0